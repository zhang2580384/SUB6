DATABASE_URL=postgresql://sub6_direct_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/sub6
# Prefer the stable HTTPS site route; never pin a release container's IP.
AUTH_URL=https://gateway.example.com/api/v1/auth/me
DIRECT_URL=https://direct.example.com
ALLOWED_ORIGINS=https://gateway.example.com,https://alternate.example.com
BRAND_NAME=SUB6
PAGE_TITLE=IP 白名单直连
PAGE_DESCRIPTION=为固定出口的服务器提供直连接口，适合下游中转和大请求上传。
ENTRY_DESCRIPTION=沿用现有 API Key、分组权限及计费。兼容 HTTP / SSE / WebSocket。
# Optional operator-owned JSON file; explicit environment values take priority.
# DIRECT_ACCESS_CONFIG_FILE=/etc/sub6-direct/settings.json
